# BEGIN Register

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Camera access stays same-origin and still requires the browser's normal
    # user permission. Microphone and geolocation remain unavailable.
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
# MultiViews interfers with proper rewriting
Options +FollowSymlinks -MultiViews

RewriteEngine On

# OAuth initiation changes server state and is deliberately POST-only. Reject
# stale crawler links before PHP starts; the application repeats this check on
# servers that do not use Apache rewrite rules.
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^auth/oauth/(?:vk|mail_ru|ok_ru|yandex)/?$ - [R=405,L,NC]

# The single-root shared-hosting package contains the complete application,
# but implementation files and operator data must never be served over HTTP.
RewriteRule ^(?:_doc|_include|_tests|tools|\.codex|\.git|\.github|\.local)(?:/|$) - [F,L,NC]
RewriteRule ^_vendor/ - [F,L,NC]
RewriteRule ^(?:composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?|psalm\.xml|rector\.php|plan-security\.md)$ - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

# Logical archive pages may deliberately retain historical filename suffixes
# such as `.py` or `.php`. Send non-physical `/files/...` paths to Register;
# real executable files still reach the deny rule below.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^files/.+ index.php [L,NC]

# PHP is executable only through the five reviewed front controllers. This
# also prevents source disclosure of templates and direct execution of style
# or extension implementation files.
RewriteRule ^(?!(?:index\.php|_admin/(?:ajax|index|install|pictman)\.php)$).+\.(?:asp|aspx|cgi|inc|jsp|phar|php[0-9]?|pht|phtml|pl|py|sh|shtml)$ - [F,L,NC]

# `_cache` contains private application state and one deliberately public
# surface: generated top-level CSS/JavaScript bundles. Everything else,
# including PHP metadata and nested tool caches, remains unreachable.
RewriteRule ^_cache/(?![A-Z0-9_-]+\.[0-9A-F]+\.(?:css|js)(?:\.asset|\.(?:br|gz|zst))?$) - [F,L,NC]

# These exact historical root URLs are handled by Register's configured
# redirect map. Route them before the root-file allow-list rejects arbitrary
# filenames with extensions.
RewriteRule ^(?:99|eat|read)\.html$ index.php [L,NC]

# `/files/` is the application-rendered archive index even when deployments
# also contain a physical `files` directory with standalone historical pages.
RewriteRule ^files/?$ index.php [L,NC]

# Only the front controller, offline worker, and conventional site metadata are
# public files at the repository root. This also protects SQLite databases with custom names.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(?!(?:index\.php|robots\.txt|favicon\.ico|site\.webmanifest|service-worker\.js(?:\.asset|\.(?:br|gz|zst))?)$)[^/]+$ - [F,L,NC]

<IfModule mod_headers.c>
# All release JS/CSS have build-time sidecars. Virtual `.asset` URLs also reach
# Apache behind an nginx static-file front end; identity remains a working fallback.
# Keep these rules after the access restrictions and outside private namespaces.
RewriteCond %{HTTP:Accept-Encoding} (^|,)[[:space:]]*br([[:space:]]*;[^,]*)?([[:space:]]*,|$) [NC]
RewriteCond %{HTTP:Accept-Encoding} !(^|,)[[:space:]]*br[[:space:]]*;[[:space:]]*q[[:space:]]*=[[:space:]]*0(\.0*)?([[:space:]]*,|$) [NC]
RewriteCond %{REQUEST_FILENAME}.br -f
RewriteRule ^((?:_admin|_assets|_extensions|_styles)/.+\.(?:css|m?js)|service-worker\.js)$ $1.br [E=no-gzip:1,E=no-brotli:1,E=no-zstd:1,L]

RewriteCond %{HTTP:Accept-Encoding} (^|,)[[:space:]]*zstd([[:space:]]*;[^,]*)?([[:space:]]*,|$) [NC]
RewriteCond %{HTTP:Accept-Encoding} !(^|,)[[:space:]]*zstd[[:space:]]*;[[:space:]]*q[[:space:]]*=[[:space:]]*0(\.0*)?([[:space:]]*,|$) [NC]
RewriteCond %{REQUEST_FILENAME}.zst -f
RewriteRule ^((?:_admin|_assets|_extensions|_styles)/.+\.(?:css|m?js)|service-worker\.js)$ $1.zst [E=no-gzip:1,E=no-brotli:1,E=no-zstd:1,L]

RewriteCond %{HTTP:Accept-Encoding} (^|,)[[:space:]]*gzip([[:space:]]*;[^,]*)?([[:space:]]*,|$) [NC]
RewriteCond %{HTTP:Accept-Encoding} !(^|,)[[:space:]]*gzip[[:space:]]*;[[:space:]]*q[[:space:]]*=[[:space:]]*0(\.0*)?([[:space:]]*,|$) [NC]
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^((?:_admin|_assets|_extensions|_styles)/.+\.(?:css|m?js)|service-worker\.js)$ $1.gz [E=no-gzip:1,E=no-brotli:1,E=no-zstd:1,L]
</IfModule>

RewriteRule ^((?:_admin|_assets|_extensions|_styles)/.+\.(?:css|m?js)|service-worker\.js)\.asset$ $1 [L]

# Uncomment and properly set the RewriteBase if the rewrite rules are not working properly
#RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
</IfModule>

<FilesMatch "(?i)(?:^\.|\.(?:bak|conf|dist|ini|log|md|neon|phar|sql|sqlite|sqlite3|yaml|yml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|m?js)(?:\.asset|\.(?:br|gz|zst))?$">
        # Unversioned module imports and workers must revalidate across releases.
        Header set Cache-Control "no-cache"
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=(%{QUERY_STRING} =~ m#(?:^|&)v=[a-f0-9]{64}(?:&|$)#) && (%{THE_REQUEST} =~ m#\.asset[? ]#)"
        Header merge Vary "Accept-Encoding"
    </FilesMatch>
    <FilesMatch "^service-worker\.js(?:\.asset|\.(?:br|gz|zst))?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(?:css|m?js)\.br$">
        Header set Content-Encoding "br"
    </FilesMatch>
    <FilesMatch "\.(?:css|m?js)\.zst$">
        Header set Content-Encoding "zstd"
    </FilesMatch>
    <FilesMatch "\.(?:css|m?js)\.gz$">
        Header set Content-Encoding "gzip"
    </FilesMatch>
</IfModule>

<IfModule mod_env.c>
    <FilesMatch "\.(?:css|m?js)\.(?:br|gz|zst)$">
        SetEnv no-gzip 1
        SetEnv no-brotli 1
        SetEnv no-zstd 1
    </FilesMatch>
</IfModule>

<FilesMatch "\.css(?:\.asset|\.(?:br|gz|zst))?$">
    ForceType "text/css; charset=UTF-8"
</FilesMatch>
<FilesMatch "\.m?js(?:\.asset|\.(?:br|gz|zst))?$">
    ForceType "application/javascript; charset=UTF-8"
</FilesMatch>

# END Register
