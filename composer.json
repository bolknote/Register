{
    "config": {
        "vendor-dir": "_vendor",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.33"
        },
        "sort-packages": true
    },
    "name": "register/blog-engine",
    "description": "Small and fast blog engine",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "Roman Parpalak",
            "email": "roman@parpalak.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-sodium": "*",
        "matthiasmullie/minify": "^1.3",
        "phpseclib/phpseclib": "^3.0.56",
        "psr/cache": "^3.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/cache": "^7.0",
        "symfony/cache-contracts": "^3.0",
        "symfony/error-handler": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/expression-language": "^7.0",
        "symfony/filesystem": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/polyfill-ctype": "^1.0",
        "symfony/polyfill-iconv": "^1.0",
        "symfony/polyfill-mbstring": "^1.0",
        "symfony/routing": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/translation-contracts": "^3.0",
        "voku/portable-ascii": "^2.1",
        "web-auth/webauthn-lib": "^5.3"
    },
    "suggest": {
        "ext-brotli": "Enables Brotli compression for dynamic responses and generated assets.",
        "ext-intl": "Uses ICU for higher-quality URL transliteration when available.",
        "ext-zlib": "Enables portable gzip compression for dynamic responses and generated assets.",
        "ext-zstd": "Enables Zstandard compression for dynamic responses and generated assets."
    },
    "autoload": {
        "psr-4": {
            "Register\\": "_include/src/Register",
            "Register\\AdminYard\\": "_include/admin-yard/src",
            "Register\\Core\\": "_include/src",
            "Register\\Extension\\": "_extensions",
            "Register\\Rose\\": "_include/src/Rose"
        },
        "files": [
            "_include/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "_generated\\": "_tests/_support/_generated/",
            "Register\\Rose\\Test\\": "_tests/unit/Rose"
        },
        "classmap": [
            "_tests/_support/"
        ]
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0.0",
        "codeception/module-phpbrowser": "^4.1",
        "codeception/stub": "^4.3",
        "phan/phan": "^6.0.7",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpmd/phpmd": "3.x-dev",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.6",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0",
        "vimeo/psalm": "^6.16"
    },
    "scripts": {
        "analyse": [
            "@analyse:phpstan",
            "@analyse:psalm",
            "@analyse:phan",
            "@analyse:phpmd",
            "@analyse:compatibility",
            "@analyse:dependencies"
        ],
        "analyse:compatibility": "phpcs --standard=tools/quality/phpcs.xml --runtime-set testVersion 8.3-8.5",
        "analyse:dependencies": [
            "composer audit --locked",
            "composer-dependency-analyser --config=tools/quality/dependency-analyser.php"
        ],
        "analyse:phan": "phan --config-file tools/quality/phan.php --allow-polyfill-parser",
        "analyse:phpmd": "php -d error_reporting=8191 _vendor/bin/phpmd analyze _admin/ajax.php _admin/index.php _admin/install.php _admin/pictman.php _include/src _include/common.php _include/functions.php _include/setup.php _extensions index.php tools --format ansi --ruleset tools/quality/phpmd.xml --no-progress",
        "analyse:phpstan": "phpstan analyse --configuration=tools/quality/phpstan.neon --no-progress --memory-limit=1G",
        "analyse:psalm": "psalm --config=tools/quality/psalm.xml --no-cache --no-progress",
        "build:shared-hosting": "php tools/build-shared-hosting.php",
        "build:release": "php tools/build-release.php",
        "check": [
            "@codeception:build",
            "@lint",
            "@analyse",
            "@rector",
            "@test"
        ],
        "codeception:build": "XDEBUG_MODE=off codecept build --config=_tests/codeception.yml --no-interaction",
        "dev": "./bin/dev",
        "lint": [
            "parallel-lint --exclude _vendor --exclude _cache --exclude _pictures --exclude .local .",
            "phpcs --standard=tools/quality/phpcs.xml",
            "@lint:shell",
            "@lint:actions"
        ],
        "lint:actions": "actionlint -shellcheck='shellcheck --severity=style'",
        "lint:shell": "shellcheck --severity=style bin/dev bin/test-acceptance",
        "rector": "rector process --dry-run --config=tools/quality/rector.php",
        "test": [
            "@test:apache-security",
            "@test:unit",
            "@test:integration",
            "@test:acceptance"
        ],
        "test:acceptance": "APP_DB_TYPE=sqlite XDEBUG_MODE=off ./bin/test-acceptance",
        "test:apache-security": "php tools/security/test-apache-policy.php",
        "test:integration": "APP_DB_TYPE=sqlite XDEBUG_MODE=off codecept run --config=_tests/codeception.yml integration --no-interaction",
        "test:unit": "XDEBUG_MODE=off codecept run --config=_tests/codeception.yml unit --no-interaction"
    }
}
