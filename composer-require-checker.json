{
    "symbol-whitelist": [
        "CURLE_COULDNT_RESOLVE_HOST",
        "CURLE_OPERATION_TIMEOUTED",
        "CURLINFO_HTTP_CODE",
        "CURLPROTO_HTTP",
        "CURLPROTO_HTTPS",
        "CURLOPT_CONNECTTIMEOUT",
        "CURLOPT_CUSTOMREQUEST",
        "CURLOPT_FOLLOWLOCATION",
        "CURLOPT_HEADER",
        "CURLOPT_HTTPHEADER",
        "CURLOPT_POSTFIELDS",
        "CURLOPT_PROTOCOLS",
        "CURLOPT_RETURNTRANSFER",
        "CURLOPT_SSL_VERIFYHOST",
        "CURLOPT_SSL_VERIFYPEER",
        "CURLOPT_TIMEOUT",
        "CURLOPT_URL",
        "CURLOPT_USERAGENT",
        "CurlHandle",
        "S2_ALLOWED_EXTENSIONS",
        "S2_BASE_URL",
        "S2_CANONICAL_URL",
        "S2_IMG_DIR",
        "S2_PATH",
        "S2_URL_PREFIX",
        "Transliterator",
        "curl_errno",
        "curl_error",
        "curl_exec",
        "curl_getinfo",
        "curl_init",
        "curl_setopt",
        "fastcgi_finish_request",
        "gzencode",
        "litespeed_finish_request",
        "newrelic_add_custom_parameter",
        "newrelic_end_transaction",
        "newrelic_name_transaction",
        "newrelic_notice_error",
        "newrelic_start_transaction",
        "opcache_invalidate"
    ],
    "php-core-extensions": [
        "Core",
        "date",
        "json",
        "hash",
        "pcre",
        "Phar",
        "Reflection",
        "SPL",
        "random",
        "standard"
    ],
    "scan-files": [
        "_admin/*.php",
        "_extensions/**/*.php",
        "_include/*.php",
        "index.php",
        "tools/queue-status.php",
        "tools/retry-background-job.php"
    ]
}
