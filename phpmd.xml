<?xml version="1.0"?>
<ruleset name="S2 strict mess detector rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 https://pmd.sourceforge.io/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="https://pmd.sourceforge.io/ruleset_xml_schema.xsd">
    <description>High-signal correctness and maintainability smells, with no baseline.</description>

    <exclude-pattern>*/lang/*</exclude-pattern>
    <exclude-pattern>*/templates/*</exclude-pattern>
    <exclude-pattern>*/views/*</exclude-pattern>
    <exclude-pattern>*/counter.php</exclude-pattern>
    <exclude-pattern>*/data.php</exclude-pattern>

    <!-- Preserve the published legacy API and database vocabulary. PHPCS,
         PHPStan and Psalm enforce naming, types and signatures more accurately. -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="BooleanArgumentFlag" />
        <exclude name="ElseExpression" />
        <exclude name="StaticAccess" />
        <exclude name="MissingImport" />
    </rule>

    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects" />
    </rule>

    <rule ref="rulesets/unusedcode.xml">
        <!-- Callback signatures and variables exported to included templates
             look unused to PHPMD; Psalm checks actual unused locals/params. -->
        <exclude name="UnusedLocalVariable" />
        <exclude name="UnusedFormalParameter" />
    </rule>
</ruleset>
